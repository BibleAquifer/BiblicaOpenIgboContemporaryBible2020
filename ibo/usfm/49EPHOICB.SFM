\id EPH - Biblica® Open Igbo Contemporary Bible 2020
\h Ndị Efesọs
\toc1 Ndị Efesọs
\toc2 Ndị Efesọs
\toc3 Efe
\mt1 Ndị Efesọs
\c 1
\p \v 1 Akwụkwọ ozi a sitere nʼaka mụ onwe m bụ Pọl, onye Chineke họpụtara ịbụ onyeozi Jisọs Kraịst.
\b
\p Ọ bụ unu ndị nsọ bi nʼEfesọs, unu bụ ndị kwesiri ntụkwasị obi nʼime Kraịst Jisọs, ka m na-edere ya:
\b
\p \v 2 Ka amara na udo nke sitere na Chineke Nna anyị, na Onyenwe anyị Jisọs Kraịst dịrị unu.
\b
\s1 Ngọzị dịrị anyị nʼime Kraịst
\p \v 3 Ka otuto dịrị Chineke, na Nna Onyenwe anyị Jisọs Kraịst, bụ onye gọziri anyị site nʼinye anyị ngọzị niile nke ime mmụọ nke si nʼebe niile nke eluigwe nʼime Kraịst. \v 4 Dịka o si họpụta anyị nʼime Kraịst tupu a tọọ ntọala ụwa, ka anyị bụrụ ndị dị nsọ na ndị na-enweghị ịta ụta nʼihu ya nʼịhụnanya. \v 5 O kpebiri ime anyị ụmụ ya site nʼihi Kraịst Jisọs. Ma o mekwara ihe ndị a niile nʼihi na ọ tọrọ ya ụtọ nʼobi, bụrụkwa ihe o zubere ime. \v 6 Ka e si otu a too ịdị ebube nke amara ya, nke o ji obi ya niile nye anyị nʼime Onye ahụ ọ hụrụ nʼanya. \v 7 Nʼime ya, anyị nwere mgbapụta site nʼọbara ya, bụ mgbaghara nke njehie niile anyị; dị ka ịba ụba nke amara ya si dị, \v 8 nke o mere ka ọ babigara anyị ụba oke site nʼamamihe na nghọta niile. \v 9 O meela ka anyị mata ihe omimi nzube ya, dị ka o si tọọ ya ụtọ, bụ ihe omimi o zubere ime nʼime Kraịst. \v 10 Nke ọ ga-eme ka o mezuo mgbe oge ya niile zuru, nke bụ ịchịkọta ihe niile nʼime ya, bụ ihe ndị dị nʼeluigwe na nʼụwa nʼokpuru Kraịst.
\p \v 11 Nʼime Kraịst ka e mere anyị ndị nketa, ndị e bururị ụzọ họpụta na mbụ, dị ka atụmatụ onye ahụ na-arụpụta ihe niile nʼizuoke nke nzube na ebumnuche ya. \v 12 Nke mere na anyị, ndị buuru ụzọ nwee olileanya na Kraịst, ga-ebi ndụ nʼotuto nke ebube ya. \v 13 Unu bụkwa ndị a gụnyere nʼime Kraịst mgbe unu nụrụ ozi nke eziokwu ahụ bụ oziọma nke nzọpụta. Mgbe unu kwenyere, a kara unu akara nʼime ya bụ akara nke nkwa ahụ bụ Mmụọ Nsọ. \v 14 Nke a bụ ihe nketa anyị tutu ruo mgbe a rụzuru ọrụ mgbapụta nke ndị ahụ niile bụ ihe nweta Chineke. Ka e si otu a too ebube ya.
\s1 Ekele na ekpere
\p \v 15 Nʼihi nke a, ebe m nụrụ akụkọ banyere okwukwe unu nʼime Onyenwe anyị Jisọs, nụkwa maka ịhụnanya unu nwere nʼebe ndị nsọ niile nọ, \v 16 esepụghị m aka ikele ekele nʼihi unu, mgbe niile m na-echeta unu nʼekpere m niile. \v 17 Ana m arịọ Chineke nke Onyenwe anyị Jisọs Kraịst bụ Nna Onyenwe ebube niile, ka o nye unu Mmụọ amamihe na ezi nghọta ka unu nwee ike matazie nke ọma onye ọ bụ, \v 18 ka o meghee anya nke ime mmụọ unu ka unu matakwa ụdị olileanya unu nwere nʼihi ọkpụkpọ ọ kpọrọ unu, na akụ, na ihe nketa dị ebube o nwere nʼime ndị nsọ. \v 19 Na ịdị ukwuu nke ike ya nke na-enweghị atụ dịrị anyị, bụ ndị kwere ekwe, dịka ịrụsị ọrụ ike nke ike ya si dị. \v 20 Nke ọ rụrụ nʼime Kraịst mgbe o si nʼọnwụ kpọlite ya mee ya ka ọ nọdụ nʼaka nri ya nʼebe niile nke eluigwe. \v 21 Ọnọdụ ya dị elu karịa ọchịchị niile, na ikike ọchịchị niile, na ike niile na ịchị isi niile, na aha ọkwa ọchịchị nke e nwere ike inye mmadụ, ọ bụghị naanị nʼọgbọ a, kama ma nʼọgbọ ọzọ na-abịa. \v 22 O mere ka ihe niile dị nʼokpuru ya, meekwa ya ka ọ bụrụ onyeisi ihe niile nye nzukọ ya bụ chọọchị. \v 23 Nke bụ ahụ ya, ozuzu oke nke onye ahụ na-emejupụta ihe niile nʼụzọ niile.
\c 2
\s1 E mere anyị ndị dị ndụ nʼime Kraịst
\p \v 1 Ma unu onwe unu, unu nwụrụ anwụ site na njehie ụzọ na mmehie unu. \v 2 Nke unu biri ndụ nʼime ha mgbe unu na-agbaso ụzọ niile nke ụwa a, na ụzọ onye ọchịchị nke alaeze ikuku, bụ mmụọ ahụ na-arụ ọrụ ugbu a na ndụ ndị ahụ na-enupu isi. \v 3 Anyị niile bikwara ndụ anyị nʼetiti ha, nʼoge gara aga, na-emejupụta agụụ nke anụ ahụ mmehie, ma na-agbaso ọchịchọ ya na ebumnuche ya. Nʼihi na site nʼọdịdị anyị, anyị na ndị ọzọ nọ nʼọmụma ikpe ya. \v 4 Chineke onye jupụtara nʼobi ebere, maka oke ịhụnanya o nwere nʼebe anyị nọ, \v 5 mere ka anyị soro Kraịst dịrị ndụ ọzọ; ọ bụladị mgbe anyị bụ ndị nwụrụ anwụ nʼime ajọ omume. Ọ bụ site nʼamara ya ka e ji zọpụta unu. \v 6 Ọ kpọlitere anyị na ya, mee ka anyị nọdụ ọdụ nʼebe niile nke eluigwe nʼime Kraịst Jisọs. \v 7 O mere nke a igosi ọgbọ nke na-abịa, ịdị ukwuu nke akụ amara ya, nke o sitere nʼobiọma ya gosi anyị nʼime Kraịst Jisọs. \v 8 Nʼihi na ọ bụ site nʼamara ka e ji zọpụta unu site nʼokwukwe. Nke a abụghị ihe unu rụpụtara nʼonwe unu, ọ bụ onyinye nke Chineke. \v 9 O siteghị nʼọrụ, ka onye ọbụla ghara ịnya isi. \v 10 Nʼihi na anyị bụ akaọrụ ya, nke o kere nʼime Kraịst Jisọs nʼihi ịrụ ezi ọrụ. Ọ bụ otu a ka Chineke siri kwadoo na anyị kwesiri ibi ndụ ụbọchị niile.
\s1 Ịbụ otu anyị nʼime Kraịst
\p \v 11 Ya mere, chetanụ na nʼoge gara aga, unu bụ ndị mba ọzọ site nʼọmụmụ nke a mụrụ unu. Chetakwanụ na “ndị e biri ugwu” na-akpọkwa unu “ndị a na-ebighị ugwu” (nʼihi obibi ugwu nʼanụ ahụ nke eji aka bie). \v 12 Nʼoge ahụ, ọ dịghị ihe jikọtara unu na Kraịst. E kewapụtara unu site na mmekọrịta nke Izrel, bụrụkwa ndị ọbịa nʼọgbụgba ndụ ahụ, na-enweghị olileanya na-enweghịkwa Chineke nʼime ụwa. \v 13 Ma ugbu a nʼime Kraịst Jisọs, unu bụ ndị nọ nʼebe dị anya nʼoge gara aga, ka e mere ka unu bịaruo nso site nʼọbara Kraịst nke a wụsiri.
\p \v 14 Nʼihi na ya onwe ya bụ udo anyị, o mere ka ụzọ otu abụọ bụrụ otu ihe nʼime ahụ ya, site na ịkwatu mgbidi kewara ha na mgbe ochie, bụ mgbidi nke ịkpọ asị dị nʼetiti anyị. \v 15 Ọ bụ nʼime anụ ahụ ya ka ọ mere ka iwu ahụ na ụkpụrụ ya niile ghara ịdị ire. Ebumnobi ya bụ i kee nʼime onwe ya otu onye ọhụrụ site na mmadụ abụọ ahụ, si otu a mee ka udo dịrị. \v 16 Nʼụzọ dị otu a ka ọ ga-esi kpeziere anyị na Chineke site nʼobe ya, wetakwa nʼisi ngwụcha, iro dị nʼetiti ha abụọ. \v 17 Ya mere, ọ bịara kwusaa udo nye unu ndị nọ ebe dị anya na unu ndị nọ nso, \v 18 Nʼihi na anyị abụọ sitere nʼaka ya nweta nnabata anyị ịbịa nʼihu Nna site nʼotu Mmụọ ahụ.
\p \v 19 Matakwanụ ugbu a na unu abụkwaghị ndị mba ọzọ na ndị ọbịa. Unu esorola ndị nsọ bụrụ diala na ndị so nʼezinaụlọ Chineke, \v 20 nke a rụkwasara nʼelu ntọala nke ndị ozi na ndị amụma, nke Kraịst Jisọs nʼonwe ya bụ nkume isi ntọala ya. \v 21 Ọ bụkwa nʼime ya ka a na-ejikọta ụlọ ahụ niile nke ọma, na-aba ụba, too bụrụ ụlọnsọ, nʼime Onyenwe anyị. \v 22 Onye a na-ewukọkwa unu onwe unu nʼotu nʼime ya, ka unu niile bụrụ ebe obibi Chineke nʼime Mmụọ.
\c 3
\s1 Pọl onye nkwusa nye ndị mba ọzọ
\p \v 1 Ọ bụ nʼihi nke a ka mụ onwe m bụ Pọl bụ onye mkpọrọ nke Jisọs Kraịst maka unu ndị mba ọzọ.
\p \v 2 Nʼihi nʼezie, unu anụla banyere nlekọta nke amara Chineke ahụ nke e nyere m maka ọdịmma unu. \v 3 Otu e si kpughee nzube nzuzo ya niile nye m, dị ka m gwara unu ihe banyere ya nʼokwu dị nta nʼakwụkwọ ozi ahụ m detara unu. \v 4 Ọ bụrụkwa na unu agụọ akwụkwọ ahụ m deere, unu ga-aghọta ihe m maara banyere ihe omimi Kraịst. \v 5 Nke a e meghị ka ụmụ mmadụ mara nʼọgbọ gara aga dị ka Mmụọ Nsọ siri kpugheere ya ndị ozi na ndị amụma ya dị nsọ ugbu a. \v 6 Otu a ka ndị mba ọzọ si soro bụrụ ndị nketa, ndị ga-abụ otu anụ ahụ na ndị ga-eketa nkwa ahụ nʼime Jisọs Kraịst site nʼoziọma.
\p \v 7 E mere m ka m bụrụ onyeozi nke oziọma a, dịka onyinye amara nke Chineke si dị, bụ nke e nyere m site nʼịrụ ọrụ nke ike ya. \v 8 Ọ bụ ezie na mụ bụ onye dịkarịsịrị nta nʼetiti ndị nsọ niile, e nyere m amara nke a, ikwusara ndị mba ọzọ oziọma banyere akụ nke enweghị atụ nke juru nʼime Kraịst, \v 9 meekwa ka mmadụ niile hụ ihe bụ atụmatụ nke ihe omimi e zoro nʼime Chineke onye kere ihe niile, ọtụtụ afọ. \v 10 Ka ọ ga-abụ site na chọọchị, a ga-eme ka amamihe Chineke nʼụdị dị iche iche bụrụ ihe ọchịchị na ikike niile dị nʼeluigwe ga-amata. \v 11 Nke a bụ nʼusoro nke atụmatụ ya dị ebighị ebi, nke e mezuru nʼime Jisọs Kraịst Onyenwe anyị, \v 12 bụ onye anyị nwere ntụkwasị obi na obi siri ike ịbịakwute site nʼokwukwe anyị nwere na ya. \v 13 Nʼihi nke a, arịọ m ka unu ghara ịda mba maka mkpagbu m nʼihi unu, ha bụ otuto nye unu.
\s1 Ekpere Pọl maka ndị Efesọs
\p \v 14 Ọ bụ nʼihi nke a ka m na-egbu ikpere m nʼala nʼihu Nna anyị, \v 15 onye ezinaụlọ niile dị nʼụwa a na nke dị nʼeluigwe na-esite nʼaka ya enwe aha. \v 16 Ekpere m bụ ka o site nʼịba ụba nke otuto ya, nye unu ike na-esite na Mmụọ ya, mee ka unu dị ike nʼime mmụọ unu; \v 17 ka Kraịst nwee ike biri nʼobi unu site nʼokwukwe, ka unu ndị gbanyere mgbọrọgwụ guzosiekwa ike nʼịhụnanya. \v 18 Ana m arịọkwa, ka unu na ndị nsọ niile nwee ike ịghọta ihe bụ obosara, ogologo, ịdị elu na ịdị omimi, \v 19 na ịmatakwa ịhụnanya nke Kraịst nke karịrị amamihe, ka unu jupụtakwa nʼizuoke niile nke Chineke.
\p \v 20 Ugbu a, nye onye ahụ pụrụ imebiga ihe nʼoke karịa ihe niile nke anyị rịọrọ, maọbụ karịa ka anyị pụrụ ichepụta nʼuche anyị, site nʼike ya nke na-arụ ọrụ nʼime anyị, \v 21 ọ bụ ya ka otuto dịrị nʼime chọọchị na nʼime Kraịst Jisọs ruo ọgbọ niile nke mgbe niile, ebighị ebi ruo ebighị ebi. Amen.
\c 4
\s1 Ịdị nʼotu nke anụ ahụ Kraịst
\p \v 1 Ya mere, mụ onwe m bụ onye mkpọrọ nke Onyenwe anyị, na-arịọ unu ka unu bie ndụ kwesiri ọkpụkpọ nke a kpọrọ unu. \v 2 Werekwanụ obi dị umeala niile na ịdị nwayọọ, na ndidi na-anagide ibe unu nʼịhụnanya. \v 3 Nọọnụ nʼudo nʼetiti onwe unu gbalịakwanụ ime ka ịdị nʼotu unu dịgide nʼime Mmụọ Nsọ. \v 4 E nwere otu ahụ na otu Mmụọ, dị ka e siri kpọọ unu nʼotu olileanya nke dịịrị ọkpụkpọ a kpọrọ unu. \v 5 Otu Onyenwe anyị dị, otu okwukwe na otu baptizim. \v 6 Ọ bụkwa naanị otu Chineke dị onye bụ Nna ihe niile na onye na-achị ihe niile, na onye na-arụ ọrụ ya nʼime ihe niile, na-ebikwa nʼime ihe niile.
\p \v 7 Ma e nyere onye ọbụla amara dịka oke onyinye nke Kraịst siri dị. \v 8 Nʼihi nke a, e kwuru,
\q1 “Mgbe ọ rigoro gaa nʼelu,
\q2 o duuru igwe ndị a dọtara nʼagha,
\q2 nyekwa ụmụ mmadụ onyinye dị iche iche.”\f + \fr 4:8 \ft \xt \ref Abụ 68:18|loc="PSA 68:18"\ref*\f*
\m \v 9 (E kwuru, “Ọ rigoro,” gịnị ka ọ pụtara ma ọ bụghị na o buru ụzọ rịdaa nʼime ala mmụọ? \v 10 Onye ahụ si nʼelu rịdata bụkwa otu onye ahụ rigoro nʼeluigwe, ka o nwee ike mejuo ihe niile.) \v 11 O nyekwara ụfọdụ onyinye ị bụ ndị ozi, ụfọdụ ndị amụma, ụfọdụ ndị nkwusa oziọma, ụfọdụ ndị ụkọchukwu na ndị nkuzi. \v 12 Nke a bụ maka ikwadobe ndị nsọ maka ọrụ nke ije ozi, iji wulite ahụ nke Kraịst; \v 13 tutu anyị niile abịa na nkwekọta banyere okwukwe anyị, na ọmụma ihe banyere ọkpara Chineke, bụrụ onye tozuru oke, ruo ọtụtụ nke ogogo na ozuzu oke nke Kraịst.
\p \v 14 Mgbe ahụ anyị agaghị abụkwa ụmụntakịrị, ndị ikuku ozizi ọhụrụ dị iche iche na-ebugharị ihu na azụ dị ka ebili mmiri, na ịgha ụgha nke mmadụ, bụ ozizi na-esite nʼime aghụghọ nke ha ji echepụta nduhie. \v 15 Kama nʼikwu eziokwu site na mmụọ ịhụnanya, anyị ga-eto bụrụ ndị tozuru oke nʼakụkụ niile nʼime ya, bụ onye ahụ bụ isi, nke bụ Kraịst. \v 16 Onye anụ ahụ niile, jikọtara ọnụ ma bụrụ otu, site na nkwonkwo niile nke na-enyezu ya nkwado, dịka akụkụ niile ọbụla na-arụ ọrụ ya nke ọma, na-esite nʼụzọ ahụ enyere akụkụ ndị ọzọ aka, ime ka ha too, nakwa iwuli ha elu site nʼịhụnanya.
\s1 Ibi ndụ dị ka ụmụ nke ihe
\p \v 17 Ya mere, ana m ekwu nke a, ma na-eguzokwa na ya nʼime Onyenwe, ka unu hapụ ibi ndụ dị ka ndị mba ọzọ si ebi, na echiche ha na-abaghị uru. \v 18 Ndị ọchịchịrị gbachiri nghọta ha. Ndị dị otu a enweghị oke na ndụ ahụ Chineke na-enye, nʼihi na obi ha mechiri emechi, ha adịghị aghọtakwa. \v 19 Ha abụrụla ndị obi ha kpọrọ nkụ, ndị were onwe ha nyefee ime ihe niile masịrị ọchịchọ ha, ka ha si otu a na-ebi ndụ adịghị ọcha niile, ha bụ ndị jupụtara nʼanya ukwu.
\p \v 20 Ma nke a abụghị otu unu siri mụta Kraịst, \v 21 ma ọ bụrụ na unu anụla ihe banyere ya, ọ bụrụkwa na unu amụtala ihe site nʼaka ya banyere eziokwu ahụ dị nʼime Jisọs. \v 22 Yipụnụ mmadụ ochie unu, nke mere ka unu na-ebi ndụ ọjọọ na mbụ, bụ mmadụ ochie ahụ nke jupụtara nʼagụụ ime ihe ọjọọ niile, \v 23 ka eme ka mmụọ nke uche unu dị ọhụrụ. \v 24 Ma yikwasịnụ onwe unu mmadụ ọhụrụ, nke e kere nʼụdịdị Chineke nʼezi omume nʼezie nakwa nʼịdị nsọ.
\p \v 25 Ya mere, wezuganụ ịgha ụgha, ka anyị niile kwuo eziokwu nye ndị agbataobi anyị, nʼihi na anyị niile bụ ndị e jikọtara nʼotu anụ ahụ. \v 26 Mgbe ị na-ewe iwe emehiekwala.\f + \fr 4:26 \ft \xt \ref Abụ 4:4|loc="PSA 4:4"\ref*\f* Ekwela ka anyanwụ daa mgbe ị ka nọ na-ewe iwe. \v 27 Enyela ekwensu ohere. \v 28 Ka onye na-ezu ohi kwụsị izu ohi. Kama ya jiri aka ya abụọ rụọ ezi ọrụ, ka o nwee ike inyere ndị ọzọ nọ na mkpa aka.
\p \v 29 Ka okwu rere ure ọbụla hapụ isite nʼọnụ unu pụta. Kama kwuonụ naanị ezi ihe nke ga-aba uru iwuli ndị ọzọ elu dịka mkpa ha si dị na iwetara ndị nụrụ ya ngọzị. \v 30 Unu akpasukwala Mmụọ Nsọ nke Chineke iwe, onye a kara unu akara nʼime ya maka ụbọchị nke mgbapụta. \v 31 Wepụnụ obi ilu niile, na obi ọjọọ na iwe, ya na nkwulu na ibu iro niile nʼetiti unu. \v 32 Nʼọnọdụ ihe ndị a niile, nweenụ obi ebere nʼebe ibe unu nọ. Gbagharanụ ibe unu dịka Chineke sitere nʼamara ya gbaghara unu nʼihi na unu bụ nke Kraịst.
\c 5
\nb \v 1 Ya mere bụrụnụ ndị na-eṅomi Chineke, dị ka ụmụ a hụrụ nʼanya. \v 2 Na-agakwanụ nʼime ịhụnanya, dịka Kraịst siri hụ anyị nʼanya ma were ndụ ya nye Chineke maka anyị dịka aja na onyinye nke isi ụtọ.
\p \v 3 Ma nʼetiti unu, ka a ghara ịkpọta mmehie ịkwa iko, maọbụ nke adịghị ọcha, maọbụ nke inwe anya ukwu aha, nʼihi na ihe ndị a ekwesighị nʼetiti ndị nsọ. \v 4 Ọ dịkwaghị mma ka unu na-ekwu okwu rụrụ arụ maọbụ okwu nzuzu maọbụ njakịrị, kama ka e nwee inye ekele. \v 5 Matanụ nke ọma na onye na-akwa iko, maọbụ onye rụrụ arụ, maọbụ onye anya ukwu, nʼihi na anya ukwu dị ka ikpere arụsị, enweghị ike ịbata nʼalaeze Kraịst na Chineke. \v 6 Unu ekwela ka onye ọbụla jiri okwu efu duhie unu. Ọ bụ nʼihi omume ọjọọ ndị a ka iwe Chineke ji abịakwasị ndị na-anaghị erubere ya isi. \v 7 Unu na ndị dị otu a enwela mmekọ.
\p \v 8 Nʼihi nʼoge gara aga, unu bụ ọchịchịrị, ma ugbu a, unu bụ ìhè nʼime Onyenwe anyị. Na-ebinụ ndụ ka ụmụ nke ìhè \v 9 (nʼihi na a na-ahụ mkpụrụ nke ìhè nʼihe niile dị mma, na ihe ziri ezi, na eziokwu). \v 10 Gbalịanụ ịchọpụta ihe na-amasị Onyenwe anyị. \v 11 Unu etinyela aka nʼọrụ ọchịchịrị nke na-adịghị amị mkpụrụ ọbụla, kama gbaanụ ha nʼanwụ. \v 12 Ọ bụ ihe ihere ikwu okwu banyere ihe ndị a na-eme na nzuzo. \v 13 Mgbe a gbara ihe ọbụla nʼanwụ, ọ na-apụta ìhè nke ọma. Nʼihi na ihe ọbụla e mere ka ọ pụta ìhè nke ọma bụ ìhè. \v 14 Nke a mere na e kwuru,
\q1 “Bilie gị onye na-arahụ ụra.
\q2 Site nʼọnwụ bilie.
\q2 Kraịst ga-emekwa ka ihe ya mụkwasị gị.”
\p \v 15 Kpachapụnụ anya otu unu si ebi ndụ unu. Unu ebila ndụ dị ka ndị nzuzu, kama bienụ ndụ dị ka ndị maara ihe. \v 16 Jirinụ ohere niile unu nwere rụọ ọrụ ọma, nʼihi na ụbọchị ndị a dị njọ. \v 17 Unu emela dị ka ndị na-enweghị uche, kama gbalịanụ ịchọpụta ihe Onyenwe anyị chọrọ ka unu mee, \v 18 Unu aṅụbigala mmanya oke nʼihi na ọ na-eduba na ndụ ịla nʼiyi. Kama jupụtanụ na Mmụọ Nsọ, \v 19 werenụ abụ ọma, na abụ nke ime mmụọ na-ekwe ukwe nʼetiti onwe unu. Werekwanụ obi unu niile na-abụrụ Onyenwe anyị abụ dị ụtọ. \v 20 Na-enyenụ Chineke bụ Nna ekele mgbe niile na nʼihe niile, nʼaha Onyenwe anyị Jisọs Kraịst.
\s1 Okwu dịrị ezinaụlọ ndị nke Kraịst
\p \v 21 Na-edonụ onwe unu nʼokpuru ibe unu site nʼegwu Kraịst.
\p \v 22 Unu ndị bụ nwunye, doonụ onwe unu nʼokpuru di unu dị ka unu si doo onwe unu nʼokpuru Onyenwe anyị. \v 23 Nʼihi na di bụ isi nwunye ya, dị ka Kraịst siri bụrụ isi nzukọ ya bụ chọọchị, na Onye nzọpụta ya nke bụ anụ ahụ ya. \v 24 Ya mere, dị ka nzukọ si edo onwe ya nʼokpuru Kraịst, otu a ka ndị bụ nwunye kwesiri ido onwe ha nʼokpuru di ha nʼihe niile.
\p \v 25 Ndị bụ di, hụnụ nwunye unu nʼanya dị ka Kraịst siri hụ nzukọ ya bụ chọọchị nʼanya nwụọ nʼihi ya. \v 26 O mere nke a ka o nwee ike doo ya nsọ, jirikwa okwu ya na ịsa mmiri nke baptizim mee ka ọ dị ọcha. \v 27 Ka o chee nzukọ nʼihu ya onwe ya dị ka ihe jupụtara nʼebube, nke na-enweghị ntụpọ, maọbụ ihu mgbarụ ma ọ bụkwanụ ihe ọbụla dị otu a. Kama nke dị nsọ na-enweghị ịta ụta. \v 28 Nʼotu ụzọ ahụ kwa, ndị bụ di kwesiri ịhụ nwunye ha nʼanya dị ka ha si hụ anụ ahụ ha nʼanya. Nʼihi na onye ọbụla hụrụ nwunye ya nʼanya na-ahụ onwe ya nʼanya. \v 29 Ọ dịghị onye ọbụla nke kpọrọ anụ ahụ ya asị. Kama, ọ na-azụ ya na-edozikwa ya, dị ka Kraịst na-emere chọọchị. \v 30 Nʼihi na anyị niile bụ akụkụ anụ ahụ ya. \v 31 “Nʼihi nke a ka nwoke ga-eji hapụ nne na nna ya e jikọta ya na nwunye ya. Ha abụọ ga-abụ otu anụ ahụ.”\f + \fr 5:31 \ft \xt \ref Jen 2:24|loc="GEN 2:24"\ref*\f* \v 32 Nke a bụ ihe omimi dị ukwuu ma eji m ya atụnyere Kraịst na chọọchị ya. \v 33 Ma otu ọ dị, onye ọbụla nʼime unu aghaghị ịhụ nwunye ya nʼanya dị ka ọ hụrụ onwe ya, nwunye ọbụla aghakwaghị ịsọpụrụ di ya.
\c 6
\s1 Ụmụntakịrị na ndị mụrụ ha
\p \v 1 Ụmụ, ruberenụ ndị mụrụ unu isi nʼihi na nke a ziri ezi nʼime Onyenwe anyị. \v 2 “Sọpụrụ nne gị na nna gị,” nʼihi na nke a bụ iwu mbụ nke nwere nkwa so ya. \v 3 “Ka ihe nwe ike na-agara gị nke ọma, ka ị biekwa ogologo ndụ nʼelu ụwa.”\f + \fr 6:3 \ft \xt \ref Dit 5:16|loc="DEU 5:16"\ref*\f*
\p \v 4 Ndị bụ nna, unu akpasukwala ụmụ unu iwe kama zụlitenụ ha nʼọzụzụ na nʼozizi nke Onyenwe anyị.
\s1 Ndị ohu na ndị nwe ha
\p \v 5 Ndị bụ ohu ruberenụ ndị nwee unu isi. Jirinụ nsọpụrụ na egwu na obi ọcha jeere ha ozi dị ka a ga-asị na ọ bụ Kraịst ka unu na-ejere ozi ahụ. \v 6 Ruberenụ ha isi, ọ bụghị naanị ka unu nata ihuọma ha mgbe ha nọ na-ele unu anya, kama dị ka ndị ohu Kraịst, ndị na-eme uche Chineke site nʼobi ha. \v 7 Jirinụ ọṅụ na ihuọma rụọ ọrụ unu dị ka ọ bụ Onyenwe anyị ka unu na-arụrụ ya, ọ bụghị mmadụ. \v 8 Nʼihi na unu maara na Onyenwe anyị ga-akwụghachi onye ọbụla maka ihe ọma ọbụla ha mere, ma ha bụ ohu maọbụ ndị nweere onwe ha.
\p \v 9 Ndị a na-ejere ozi, mesonụ ndị na-ejere unu ozi mmeso nʼụzọ dị otu a. Abarala ha mba, nʼihi na ị matara na unu nwere naanị otu Nna ukwu nọ nʼeluigwe. Ile mmadụ anya nʼihu adịghịkwa nʼebe ọ nọ.
\s1 Ngwa agha Chineke
\p \v 10 Nʼikpeazụ, dịnụ ike nʼime Onyenwe anyị na nʼime ike ya dị ukwuu. \v 11 Yikwasịnụ ngwa agha niile Chineke ka unu nwee ike iguzosi ike megide nzube ọjọọ niile nke ekwensu. \v 12 Nʼihi na ndị anyị na-alụso ọgụ abụghị ndị mmadụ efu nwere anụ ahụ na ọbara, kama ọ bụ megide ndịisi ha niile, megide ịchị isi niile, megide ike usuu mmụọ ọjọọ nke ike ụwa ọchịchịrị a, megidekwa mmụọ ajọ ihe niile nọ nʼebe dị elu nke eluigwe. \v 13 Ya mere, yikwasịnụ ngwa agha niile nke Chineke ka unu nwee ike iguzosi ike mgbe onye iro ahụ ga-alụso unu ọgụ. Ka unu nweekwa ike iguzo ọ bụladị mgbe unu chụghachiri ha azụ. \v 14 Meenụ ka eziokwu dịrị unu dị ka eriri akwa nke a na-eji ekesi akwa ike, ezi omume bụrụkwa ihe dị mkpa dị ka ihe agha unu ji ekpuchi obi unu. \v 15 Werenụ njikere nke ikwusa oziọma nke udo yikwasị dị ka akpụkpọ nʼụkwụ unu. \v 16 Mgbe niile, unu echefula ijide okwukwe unu dị ka ọta nke unu ga-eji kụchapụ àkụ niile na-enwu ọkụ nke ajọ onye ahụ ga-agba nʼebe unu nọ. \v 17 Nabatanụ nzọpụta dị ka okpu igwe, werekwanụ okwu Chineke dị ka mma agha nke Mmụọ Nsọ na-enye unu.
\p \v 18 Ma kpeenụ ekpere nʼime Mmụọ nʼoge niile na ụdị ekpere na arịrịọ niile. Nọọnụ na njikere mgbe niile ma nọgidekwanụ na-ekpere ndị nsọ niile ekpere oge niile. \v 19 Na-echetakwanụ m nʼekpere, ka e nye m ike nke mkwuwa okwu, m ga-eji na-ekwupụta ihe omimi nke oziọma na-atụghị egwu ọbụla, \v 20 nke m ji maka ya bụrụ onye nnọchite anya nọ na mkpọrọ. Kperenụ m ekpere ka m kwupụta ya nʼatụghị egwu ọbụla dị ka m kwesiri ikwu.
\b
\s1 Okwu mmechi
\p \v 21 Ugbu a, iji mee ka unu mara otu m dị na ihe m na-eme, Taịkikọs, nwanna m hụrụ nʼanya na nwaodibo kwesiri ntụkwasị obi nʼime Onyenwe anyị ga-akọrọ unu ihe niile. \v 22 Ana m ezitere ya unu nʼihi nke a, ka o mee ka unu mata ọnọdụ anyị nakwa ka ọ gbaa unu ume.
\b
\p \v 23 Ka udo na ịhụnanya, tinyere okwukwe nke sitere na Chineke Nna na Onyenwe anyị Jisọs Kraịst dịịrị unu ụmụnna.
\b
\p \v 24 Ka amara dịnyere ndị niile ji ịhụnanya na-adịghị anwụ anwụ hụ Onyenwe anyị Jisọs Kraịst nʼanya.
